# Read at build time by `next build` (copy to .env.production for a deploy). The site is a static export, so these are
# baked into the HTML and no runtime environment is needed for the pages themselves.

# Sanity project id and dataset (sanity.io/manage). Required for a real build; without it the site uses fallback content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read-only "Viewer" token. The dataset is PRIVATE because lead documents hold personal data, so the build must
# authenticate. It is only used while building and never ends up in the site.
SANITY_READ_TOKEN=

# Public URL of the deployed site: canonical links, Open Graph, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (published test key, safe for local use)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional Google Tag Manager container id
NEXT_PUBLIC_GTM_ID=

# Tests only: point the build at the local mock (`npm run mock:sanity`). Never set this for a deploy.
# SANITY_API_HOST=http://localhost:4010
