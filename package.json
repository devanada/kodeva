{
  "name": "kodeva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-build-env.mjs && next build",
    "lint": "eslint src functions scripts",
    "lint:fix": "npm run lint -- --fix",
    "typescript": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"functions/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "preview": "wrangler pages dev out",
    "seed": "node scripts/seed-sanity.mjs",
    "mock:sanity": "node scripts/mock-sanity.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "predeploy": "node scripts/check-deploy.mjs",
    "deploy": "npm run build && wrangler pages deploy out --project-name kodeva"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
