# Read by the Sanity Studio only (copy to studio/.env). The Studio is a separate package with its own environment, and it
# only exposes variables that start with SANITY_STUDIO_ to its browser bundle, which is why these are not the same names
# as the root .env (SANITY_PROJECT_ID / SANITY_DATASET). The values are the same.

# Project id from sanity.io/manage (the same one as SANITY_PROJECT_ID at the repo root)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Hostname of the hosted Studio: https://<this>.sanity.studio. Pick a unique name.
SANITY_STUDIO_HOST=
